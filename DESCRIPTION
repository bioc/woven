Package: woven
Title: Weighted Omics View Embedding via Nystrom for Incomplete Multi-Omics Data
Version: 0.99.6
Authors@R: c(
    person("Nathan", "Bresette",
           role = c("aut", "cre"),
           email = "nathanbresette04@gmail.com",
           comment = c(ORCID = "0009-0003-1554-6006")),
    person("Ai-Ling", "Lin",
           role = "aut"),
